+    await adapter.sendQuestionCard('oc_1', qState);
+    expect(record).toHaveBeenCalledWith(expect.objectContaining({ kind: 'card' }));
+    const text = record.mock.calls[0][0].text as string;
+    expect(text).toContain('今晚吃什么');
