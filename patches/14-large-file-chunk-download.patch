+      const actual = fs.statSync(savePath).size;
+      if (actual !== total) {
+        throw new Error(`assembled file size ${actual} != expected ${total}`);
+      }
+      this.logger.info(
+        { messageId, resourceKey, savePath, size: total, elapsedMs: Date.now() - startedAt },
